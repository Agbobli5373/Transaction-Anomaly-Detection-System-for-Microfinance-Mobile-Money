# Secret key used to pseudonymise MSISDNs into Wallet IDs. Use a long random value; never commit the real one.
TXRISK_PSEUDONYM_KEY=change-me

# The compose Postgres (`make up`). Set both to the same random value without URL-special
# characters, e.g. the output of `openssl rand -hex 16`: the Postgres image creates its user with
# the first, and the API, migration job and seed connect with the second (libpq's standard
# variable), so no credential appears in any URL or committed file.
POSTGRES_PASSWORD=
PGPASSWORD=

# The model bundle the API scores with, as mounted in compose: /models/<version> from `make train`.
# Leave empty to score with the rules alone.
TXRISK_MODEL_BUNDLE=

# The recent-history cache (ADR 0006) is the compose `redis` service, set in docker-compose.yml as
# TXRISK_REDIS_URL. Outside compose, set TXRISK_REDIS_URL (redis://host:port/db) to cache history in
# Redis for the API and the workers, or leave it unset to read history from Postgres alone.
