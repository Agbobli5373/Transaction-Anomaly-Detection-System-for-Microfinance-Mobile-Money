# Secret key used to pseudonymise MSISDNs into Wallet IDs. Use a long random value; never commit the real one.
TXRISK_PSEUDONYM_KEY=change-me

# The compose Postgres (`make up`). Set both to the same random value without URL-special
# characters, e.g. the output of `openssl rand -hex 16`: the Postgres image creates its user with
# the first, and the API, migration job and seed connect with the second (libpq's standard
# variable), so no credential appears in any URL or committed file.
POSTGRES_PASSWORD=
PGPASSWORD=

# The login of txrisk_app, the least-privilege database role the API and workers connect as (it may
# only select from and insert into the audit log). `txrisk migrate` creates the role with it, and
# the services read it from here. Use a different random value from the two above, e.g. the output
# of `openssl rand -hex 16`.
TXRISK_APP_DB_PASSWORD=

# The model bundle the API scores with, as mounted in compose: /models/<version> from `make train`.
# Leave empty to score with the rules alone.
TXRISK_MODEL_BUNDLE=
TXRISK_SCORING_TIMEOUT_MS=
TXRISK_MODEL_RETRY_SECONDS=

# Browser origins allowed to call the API, comma-separated (no wildcard): the Case workbench.
TXRISK_CORS_ORIGINS=http://localhost:3000

# The Case workbench (http://localhost:3000): encrypts the browser's session cookie. At least 32
# characters of randomness, e.g. the output of `openssl rand -hex 32`; the workbench refuses to
# start without one.
AUTH_SECRET=

# The recent-history cache (ADR 0006) is the compose `redis` service, set in docker-compose.yml as
# TXRISK_REDIS_URL. Outside compose, set TXRISK_REDIS_URL (redis://host:port/db) to cache history in
# Redis for the API and the workers, or leave it unset to read history from Postgres alone.

# Grafana's admin password for the compose Grafana (http://localhost:3001): set it to a random
# value, e.g. the output of `openssl rand -hex 16`. Grafana refuses to start without one.
GF_SECURITY_ADMIN_PASSWORD=

# Tracing is off by default. Set to true to send OpenTelemetry traces from the API, workers and
# producers to the compose Jaeger (http://localhost:16686).
TXRISK_TRACING_ENABLED=false

# The evaluation pages (http://localhost:8501) read the API with one API key that has the
# models:read scope. Issue it with `docker compose exec api txrisk api-key --name evaluation-pages
# --scope models:read` (shown once) and put it here; the pages get no other setting.
TXRISK_EVALUATION_API_KEY=
