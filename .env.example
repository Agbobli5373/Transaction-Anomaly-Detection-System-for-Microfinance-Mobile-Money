# Secret key used to pseudonymise MSISDNs into Wallet IDs. Use a long random value; never commit the real one.
TXRISK_PSEUDONYM_KEY=change-me

# Password for the compose Postgres (`make up`). Required; compose refuses to start without it.
# Use a random value without URL-special characters, e.g. the output of `openssl rand -hex 16`.
POSTGRES_PASSWORD=
