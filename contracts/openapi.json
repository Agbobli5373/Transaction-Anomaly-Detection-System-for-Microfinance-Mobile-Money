{
  "components": {
    "schemas": {
      "ActiveModel": {
        "additionalProperties": false,
        "properties": {
          "fitted_on": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fitted On"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "thresholds": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Thresholds",
            "type": "object"
          }
        },
        "required": [
          "model_version",
          "thresholds",
          "fitted_on"
        ],
        "title": "ActiveModel",
        "type": "object"
      },
      "AlertOut": {
        "additionalProperties": false,
        "properties": {
          "alert_id": {
            "title": "Alert Id",
            "type": "integer"
          },
          "assessment": {
            "$ref": "#/components/schemas/AssessmentOut"
          },
          "raised_at": {
            "format": "date-time",
            "title": "Raised At",
            "type": "string"
          },
          "subject_wallet_id": {
            "title": "Subject Wallet Id",
            "type": "string"
          },
          "transaction_id": {
            "title": "Transaction Id",
            "type": "string"
          }
        },
        "required": [
          "alert_id",
          "transaction_id",
          "subject_wallet_id",
          "raised_at",
          "assessment"
        ],
        "title": "AlertOut",
        "type": "object"
      },
      "AlertPage": {
        "additionalProperties": false,
        "properties": {
          "alerts": {
            "items": {
              "$ref": "#/components/schemas/AlertOut"
            },
            "title": "Alerts",
            "type": "array"
          },
          "next_before": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Before"
          }
        },
        "required": [
          "alerts",
          "next_before"
        ],
        "title": "AlertPage",
        "type": "object"
      },
      "AssessmentOut": {
        "additionalProperties": false,
        "properties": {
          "component_scores": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "title": "Component Scores",
            "type": "object"
          },
          "degraded": {
            "title": "Degraded",
            "type": "boolean"
          },
          "model_version": {
            "title": "Model Version",
            "type": "string"
          },
          "reasons": {
            "items": {
              "$ref": "#/components/schemas/ReasonOut"
            },
            "title": "Reasons",
            "type": "array"
          },
          "risk_band": {
            "enum": [
              "Low",
              "Medium",
              "High"
            ],
            "title": "Risk Band",
            "type": "string"
          },
          "risk_score": {
            "title": "Risk Score",
            "type": "number"
          },
          "transaction_id": {
            "title": "Transaction Id",
            "type": "string"
          }
        },
        "required": [
          "transaction_id",
          "risk_score",
          "risk_band",
          "reasons",
          "component_scores",
          "model_version",
          "degraded"
        ],
        "title": "AssessmentOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ReasonOut": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "code",
          "message",
          "value"
        ],
        "title": "ReasonOut",
        "type": "object"
      },
      "Status": {
        "additionalProperties": false,
        "properties": {
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          },
          "status": {
            "enum": [
              "ok",
              "unavailable"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Status",
        "type": "object"
      },
      "TransactionIn": {
        "additionalProperties": false,
        "description": "A Transaction as the ledger reports it: exactly one Counterparty, of the kind its\nTransaction type deals with, and no balance after.",
        "properties": {
          "agent_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Id"
          },
          "amount": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Amount"
          },
          "biller_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Biller Id"
          },
          "channel": {
            "enum": [
              "ussd",
              "app"
            ],
            "title": "Channel",
            "type": "string"
          },
          "counterparty_wallet_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Counterparty Wallet Id"
          },
          "device_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Device Id",
            "type": "string"
          },
          "direction": {
            "enum": [
              "in",
              "out"
            ],
            "title": "Direction",
            "type": "string"
          },
          "merchant_id": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Merchant Id"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "region": {
            "maxLength": 64,
            "minLength": 1,
            "title": "Region",
            "type": "string"
          },
          "subject_balance_before": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "type": "string"
              }
            ],
            "title": "Subject Balance Before"
          },
          "subject_wallet_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Subject Wallet Id",
            "type": "string"
          },
          "transaction_id": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Transaction Id",
            "type": "string"
          },
          "transaction_type": {
            "enum": [
              "cash_in",
              "cash_out",
              "transfer",
              "payment",
              "bill_payment"
            ],
            "title": "Transaction Type",
            "type": "string"
          }
        },
        "required": [
          "transaction_id",
          "occurred_at",
          "transaction_type",
          "amount",
          "subject_wallet_id",
          "direction",
          "subject_balance_before",
          "channel",
          "device_id",
          "region"
        ],
        "title": "TransactionIn",
        "type": "object"
      },
      "TransactionOut": {
        "additionalProperties": false,
        "properties": {
          "agent_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent Id"
          },
          "amount": {
            "title": "Amount",
            "type": "number"
          },
          "biller_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Biller Id"
          },
          "channel": {
            "title": "Channel",
            "type": "string"
          },
          "counterparty_wallet_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Counterparty Wallet Id"
          },
          "device_id": {
            "title": "Device Id",
            "type": "string"
          },
          "direction": {
            "title": "Direction",
            "type": "string"
          },
          "merchant_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Merchant Id"
          },
          "occurred_at": {
            "format": "date-time",
            "title": "Occurred At",
            "type": "string"
          },
          "region": {
            "title": "Region",
            "type": "string"
          },
          "subject_balance_before": {
            "title": "Subject Balance Before",
            "type": "number"
          },
          "subject_wallet_id": {
            "title": "Subject Wallet Id",
            "type": "string"
          },
          "transaction_id": {
            "title": "Transaction Id",
            "type": "string"
          },
          "transaction_type": {
            "title": "Transaction Type",
            "type": "string"
          }
        },
        "required": [
          "transaction_id",
          "occurred_at",
          "transaction_type",
          "amount",
          "subject_wallet_id",
          "direction",
          "subject_balance_before",
          "channel",
          "device_id",
          "region"
        ],
        "title": "TransactionOut",
        "type": "object"
      },
      "TransactionView": {
        "additionalProperties": false,
        "properties": {
          "assessment": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AssessmentOut"
              },
              {
                "type": "null"
              }
            ]
          },
          "transaction": {
            "$ref": "#/components/schemas/TransactionOut"
          }
        },
        "required": [
          "transaction",
          "assessment"
        ],
        "title": "TransactionView",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "description": "Scores mobile money Transactions for risk and explains why. Advisory only: it raises Alerts for people to review and never blocks a Transaction.",
    "title": "Transaction risk scoring",
    "version": "1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/v1/alerts": {
      "get": {
        "description": "Alerts, newest first.",
        "operationId": "get_alerts_v1_alerts_get",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 500,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "description": "next_before of the previous page",
            "in": "query",
            "name": "before",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "next_before of the previous page",
              "title": "Before"
            }
          },
          {
            "in": "query",
            "name": "subject_wallet_id",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Subject Wallet Id"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AlertPage"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Alerts",
        "tags": [
          "alerts"
        ]
      }
    },
    "/v1/health": {
      "get": {
        "description": "Liveness: the process is up. It does not touch the database.",
        "operationId": "health_v1_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "operations"
        ]
      }
    },
    "/v1/models/active": {
      "get": {
        "description": "The model version that scores, and its Risk band thresholds.",
        "operationId": "get_active_model_v1_models_active_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ActiveModel"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Get Active Model",
        "tags": [
          "models"
        ]
      }
    },
    "/v1/ready": {
      "get": {
        "description": "Readiness: the database answers and every migration has been applied.",
        "operationId": "ready_v1_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            },
            "description": "Not ready to score"
          }
        },
        "summary": "Ready",
        "tags": [
          "operations"
        ]
      }
    },
    "/v1/score": {
      "post": {
        "description": "Score a Transaction and store it with its Risk assessment; a High Risk band raises\nan Alert. Idempotent on `transaction_id`: a repeat returns the stored assessment, marked\nwith the `Idempotent-Replayed: true` header, and raises no second Alert.",
        "operationId": "score_v1_score_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TransactionIn"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssessmentOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Score",
        "tags": [
          "scoring"
        ]
      }
    },
    "/v1/transactions/{transaction_id}": {
      "get": {
        "description": "A stored Transaction and its Risk assessment, if it was scored.",
        "operationId": "get_transaction_v1_transactions__transaction_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "transaction_id",
            "required": true,
            "schema": {
              "title": "Transaction Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TransactionView"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "description": "No such Transaction"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Transaction",
        "tags": [
          "transactions"
        ]
      }
    }
  }
}
