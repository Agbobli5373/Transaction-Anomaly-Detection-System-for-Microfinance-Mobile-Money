{
  "uid": "txrisk-fraud-outcomes",
  "title": "Fraud outcomes",
  "tags": [
    "txrisk",
    "monitoring"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "description": "Where Fraud discoveries came from (complaints, chargebacks or Cases), by Channel, and how many of the Fraud-labelled Transactions the Champion model had scored High. Fraud labels only; Ground truth never reaches the system (ADR 0007).",
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Discoveries (the window in config/monitoring.toml)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "Discoveries by Channel",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "txrisk_monitoring_discoveries_by_channel",
          "legendFormat": "{{channel}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": ""
    },
    {
      "id": 3,
      "type": "piechart",
      "title": "Discoveries by source",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "txrisk_monitoring_discoveries_by_source",
          "legendFormat": "{{source}}",
          "refId": "A",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "x": 8,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        },
        "legend": {
          "displayMode": "table",
          "values": [
            "value"
          ]
        }
      },
      "description": "Complaints, chargebacks and Cases."
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Complaint share",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "txrisk_monitoring_discovery_share{source=\"complaint\"}",
          "legendFormat": "complaints",
          "refId": "A",
          "instant": true,
          "range": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "txrisk_monitoring_discovery_share{source=\"case\"}",
          "legendFormat": "Cases",
          "refId": "B",
          "instant": true,
          "range": false
        }
      ],
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "description": "Share of the window's Fraud discoveries that came from complaints, and from Cases."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Discoveries a day by Channel",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "txrisk_monitoring_discoveries_day",
          "legendFormat": "{{channel}}",
          "refId": "A",
          "instant": false,
          "range": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "stacking": {
              "mode": "normal"
            },
            "fillOpacity": 40
          }
        },
        "overrides": []
      },
      "options": {},
      "description": ""
