        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "txrisk_monitoring_discovery_share{source=\"complaint\"}",
          "legendFormat": "complaints",
          "refId": "A",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "txrisk_monitoring_discovery_share{source=\"case\"}",
          "legendFormat": "Cases",
          "refId": "B",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "txrisk_monitoring_discovery_share{source=\"chargeback\"}",
          "legendFormat": "chargebacks",
          "refId": "C",
          "instant": false,
          "range": true
        }
      ],
      "gridPos": {
        "x": 12,
        "y": 9,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1
        },
        "overrides": []
      },
      "options": {},
      "description": ""
    },
    {
      "id": 7,
      "type": "row",
      "title": "Recall against discovered labels",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Recall against discovered labels",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
