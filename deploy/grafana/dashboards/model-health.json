    {
      "id": 13,
      "type": "timeseries",
      "title": "Alert volume vs budget",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "txrisk_monitoring_alert_volume",
          "legendFormat": "Alerts",
          "refId": "A",
          "instant": false,
          "range": true
