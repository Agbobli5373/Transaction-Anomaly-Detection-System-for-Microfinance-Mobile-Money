        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "txrisk_monitoring_alert_budget * txrisk_monitoring_alert_volume_ratio_min",
          "legendFormat": "band minimum",
          "refId": "C",
          "instant": false,
          "range": true
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "txrisk_monitoring_alert_budget * txrisk_monitoring_alert_volume_ratio_max",
          "legendFormat": "band maximum",
          "refId": "D",
          "instant": false,
          "range": true
        }
      ],
      "gridPos": {
        "x": 0,
        "y": 31,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "lineWidth": 2
          }
        },
        "overrides": []
      },
      "options": {},
      "description": "Alerts raised on the monitored day against the Alert budget per day and the band around it (config/monitoring.toml) outside which an alert fires."
    },
