# The development Keycloak's settings (`make up`): copy to keycloak.env, which is gitignored.
# Only Keycloak reads this file, and the API never sees it.

# Sign-in values for the realm's demo users demo-analyst, demo-supervisor and demo-admin. Keycloak
# substitutes them into config/keycloak/txrisk-realm.json when it imports the realm, so none is
# committed. Set each to its own random value of at least 12 characters, e.g.
# `openssl rand -hex 16`; Keycloak refuses to start while any is missing. The demo users and the
# txrisk-demo-cli client are for development only.
TXRISK_DEMO_SIGNIN_ANALYST=
TXRISK_DEMO_SIGNIN_SUPERVISOR=
TXRISK_DEMO_SIGNIN_ADMIN=

# Optional: a bootstrap admin for the console at http://localhost:8080/admin. Leave both empty
# for none.
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
