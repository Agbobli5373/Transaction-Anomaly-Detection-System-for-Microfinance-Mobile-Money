# The Case workbench's settings (copy to .env for `npm run dev`; compose passes the same names from
# the repository's own .env). None is committed with a value.

# Encrypts the browser's session cookie. At least 32 characters of randomness, e.g.
# `openssl rand -hex 32`; the workbench refuses to start without it.
AUTH_SECRET=

# The txrisk realm as browsers and tokens name it, and as the Next.js server reaches it (differs
# inside compose, where the server reaches Keycloak as http://keycloak:8080).
OIDC_ISSUER=http://localhost:8080/realms/txrisk
OIDC_INTERNAL_ISSUER=
OIDC_CLIENT_ID=txrisk-workbench

# The txrisk API, as the Next.js server reaches it.
TXRISK_API_URL=http://localhost:8000

# Where browsers reach the workbench. An https:// URL makes the cookies Secure.
WORKBENCH_PUBLIC_URL=http://localhost:3000
